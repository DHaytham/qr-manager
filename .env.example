# Copy this file to ".env" for local development. Never commit .env.

# Postgres connection string. From Neon: Dashboard -> Connect -> copy the connection string.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Password for the admin dashboard. If empty locally, the password is "admin".
ADMIN_PASSWORD=change-me

# Any long random string; used to sign login tokens.
SESSION_SECRET=replace-with-a-long-random-string

# Optional: the public address put inside QR codes, e.g. https://qr.yourdomain.com
# On Render this is detected automatically, so you can leave it empty.
PUBLIC_BASE_URL=
